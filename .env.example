# .env.local 로 복사해서 값 채우기 (Vercel에는 Project Settings > Environment Variables 에 동일하게 등록)

# 배포 도메인 (OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys. secret key는 서버에서만 쓰이며 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=

# IP 해시용 임의 문자열 (예: openssl rand -hex 16)
IP_HASH_SALT=

# 선택: Adobe Fonts 웹 프로젝트 ID (IvyOra Display, Altesse Std)
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

# 선택: 카카오톡 공유용 JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=
